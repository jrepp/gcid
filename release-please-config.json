{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "tag-separator": "/",
  "separate-pull-requests": true,
  "packages": {
    ".": {
      "release-type": "python",
      "package-name": "gcid",
      "component": "python",
      "exclude-paths": ["go/gcid", "rust/gcid", "java/gcid"]
    },
    "go/gcid": {
      "release-type": "go",
      "component": "go/gcid",
      "initial-version": "0.1.0"
    },
    "rust/gcid": {
      "release-type": "rust",
      "component": "rust/gcid"
    },
    "java/gcid": {
      "release-type": "maven",
      "component": "java/gcid"
    }
  }
}
